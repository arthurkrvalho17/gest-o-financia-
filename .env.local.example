# Copie este arquivo para ".env.local" e preencha com os dados do SEU projeto Supabase.
# Em Supabase → Project Settings → API:
#   - Project URL      -> VITE_SUPABASE_URL
#   - anon public key   -> VITE_SUPABASE_ANON_KEY
#
# NUNCA coloque a service_role key aqui. Só a anon key entra no front.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key-aqui
